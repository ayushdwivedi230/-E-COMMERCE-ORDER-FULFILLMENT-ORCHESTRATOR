# E-Commerce Order Fulfillment Orchestrator Configuration

# Database Configuration
# Primary: PostgreSQL (production / standard setup)
# Fallback: SQLite (development / local offline testing)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db
# SQLite fallback example:
# DATABASE_URL=sqlite:///./ecommerce.db

# Application Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Fraud Check Agent Risk Thresholds
FRAUD_LOW_THRESHOLD=29
FRAUD_MEDIUM_THRESHOLD=69
FRAUD_HIGH_THRESHOLD=70

# Pricing Agent Parameters
DEFAULT_TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD=100.00
STANDARD_SHIPPING_COST=5.00
EXPRESS_SHIPPING_COST=15.00

# Microsoft Agent Framework / AI Model Settings
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
OPENAI_API_KEY=
MODEL_NAME=gpt-4o
ENABLE_LLM_REASONING=false
